{
  "name": "bitchord-monochrome-addon",
  "version": "1.0.0",
  "description": "Lossless FLAC & Hi-Res audio provider add-on for BitChord backed by Monochrome HiFi API network.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx tests/liveIntegration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acedreamer/bitchord-monochrome-addon.git"
  },
  "bugs": {
    "url": "https://github.com/acedreamer/bitchord-monochrome-addon/issues"
  },
  "homepage": "https://github.com/acedreamer/bitchord-monochrome-addon#readme",
  "keywords": [
    "bitchord",
    "monochrome",
    "lossless",
    "flac",
    "audio",
    "addon"
  ],
  "author": "BitChord Community",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "fastify": "^4.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2"
  }
}
